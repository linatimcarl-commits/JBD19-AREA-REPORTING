 current: rows.reduce((a,r)=>a+(r.current??0),0),
 last: rows.reduce((a,r)=>a+(r.last??0),0),
 forecast: rows.reduce((a,r)=>a+(r.forecast??0),0),
 population: rows.reduce((a,r)=>a+(r.population??0),0),
 currentCount: rows.filter(r=>r.current!=null).length,
 lastCount: rows.filter(r=>r.last!=null).length,
 varianceRows: rows.filter(r=>r.variance!=null),
 positive: rows.filter(r=>(r.current!=null&&r.last!=null?r.current-r.last:r.variance)>0).length,
 negative: rows.filter(r=>(r.current!=null&&r.last!=null?r.current-r.last:r.variance)<0).length,
 incomplete: rows.filter(r=>r.current==null||r.last==null).length
});
const fmtPct=(a,b)=>b?((a-b)/Math.abs(b)*100).toFixed(1)+"%":"—";
function inputVal(v){return v==null?"":String(v);}
function bindEditableCells(){
 document.querySelectorAll(".edit-cell").forEach(el=>{
  el.addEventListener("change",()=>{
   const si=Number(el.dataset.si),ri=Number(el.dataset.ri),field=el.dataset.field;
   let value=el.value.trim();
   if(field==="name"){if(!value){alert("Account name cannot be blank.");el.value=DATA[si].records[ri].name;return;}DATA[si].records[ri][field]=value;}
   else DATA[si].records[ri][field]=value===""?null:Number(value);
   const rec=DATA[si].records[ri];
   if(rec.current!=null&&rec.last!=null) rec.variance=rec.current-rec.last;
   else rec.variance=null;
   persist();render();
  });
 });
}
function addAccount(){
 const storeName=document.getElementById("storeFilter").value;
 const target=storeName==="all"?DATA[0]:DATA.find(s=>s.store===storeName);
 if(!target){alert("Select a store first, then add an account.");return;}
 const name=prompt("Enter the account or establishment name:");
 if(!name||!name.trim())return;
 target.records.push({name:name.trim(),population:null,forecast:null,current:null,last:null,variance:null});
 persist();document.getElementById("search").value="";render();
}
function exportCSV(){
 const headers=["Store","Account / Establishment","Population","Forecasted Sales","Current Year Sales","Last Year Sales","Variance"];
 const lines=[headers,...allRowsForExport().map(r=>[r.store,r.name,r.population??"",r.forecast??"",r.current??"",r.last??"",r.current!=null&&r.last!=null?r.current-r.last:(r.variance??"")])];
 const csv=lines.map(row=>row.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(",")).join("\\r\\n");
 const blob=new Blob(["\\ufeff"+csv],{type:"text/csv;charset=utf-8;"});
 const url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download="JCBOS_Historical_Account_Data.csv";a.click();URL.revokeObjectURL(url);
}
function allRowsForExport(){return DATA.flatMap(s=>s.records.map(r=>({...r,store:s.store})));}
function populateStores(){const el=document.getElementById("storeFilter");DATA.forEach(s=>{const o=document.createElement("option");o.value=s.store;o.textContent=s.store;el.appendChild(o)});}
function filtered(){
 const st=document.getElementById("storeFilter").value, status=document.getElementById("statusFilter").value, q=document.getElementById("search").value.toLowerCase().trim();
 return getAllRows().filter(r=>(st==="all"||r.store===st)&&(!q||(r.name+" "+r.store).toLowerCase().includes(q))&&
 (status==="all"||(status==="positive"&&((r.current!=null&&r.last!=null?r.current-r.last:r.variance)>0))||(status==="negative"&&((r.current!=null&&r.last!=null?r.current-r.last:r.variance)<0))||(status==="missing"&&(r.current==null||r.last==null))));
}
function render(){
 const rows=filtered(), t=totals(rows), variance=t.current-t.last;
 document.getElementById("kpis").innerHTML=[
 ["CURRENT YEAR SALES",money(t.current),"Recorded entries: "+t.currentCount],
 ["LAST YEAR SALES",money(t.last),"Recorded entries: "+t.lastCount],
 ["SALES VARIANCE",money(variance),fmtPct(t.current,t.last)+" vs. last year"],
 ["FORECASTED SALES",money(t.forecast),"Population recorded: "+number(t.population)]
 ].map(x=>`<div class="card kpi"><div class="kpi-label">${x[0]}</div><div class="kpi-value">${x[1]}</div><div class="kpi-note">${x[2]}</div></div>`).join("");
 document.getElementById("recordCount").textContent=rows.length+" records";
 document.getElementById("dataRows").innerHTML=rows.map(r=>{
  const si=DATA.findIndex(s=>s.store===r.store);
  const ri=DATA[si].records.findIndex(x=>x.name===r.name);
  const v=(r.current!=null&&r.last!=null)?r.current-r.last:r.variance;
  const vClass=v==null?"neutral":v>0?"positive":v<0?"negative":"neutral";
  return `<tr>
   <td>${esc(r.store)}</td>
   <td><input aria-label="Account name" class="edit-cell name-cell" value="${esc(r.name)}" data-si="${si}" data-ri="${ri}" data-field="name"></td>
   <td><input aria-label="Population" class="edit-cell" type="number" min="0" step="1" value="${inputVal(r.population)}" placeholder="—" data-si="${si}" data-ri="${ri}" data-field="population"></td>
   <td><input aria-label="Forecasted sales" class="edit-cell" type="number" min="0" step="0.01" value="${inputVal(r.forecast)}" placeholder="—" data-si="${si}" data-ri="${ri}" data-field="forecast"></td>
   <td><input aria-label="Current year sales" class="edit-cell" type="number" min="0" step="0.01" value="${inputVal(r.current)}" placeholder="—" data-si="${si}" data-ri="${ri}" data-field="current"></td>
   <td><input aria-label="Last year sales" class="edit-cell" type="number" min="0" step="0.01" value="${inputVal(r.last)}" placeholder="—" data-si="${si}" data-ri="${ri}" data-field="last"></td>
   <td class="num ${vClass}">${v==null?"—":(v>0?"+":"")+money(v)}</td>
  </tr>`;
 }).join("")||`<tr><td colspan="7" style="text-align:center;padding:28px;color:#7b8493">No matching records.</td></tr>`;
 bindEditableCells();
 renderStoreSummary(); drawCharts();
}
function esc(s){return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
function renderStoreSummary(){
 const st=document.getElementById("storeFilter").value;
 const list=DATA.filter(s=>st==="all"||s.store===st);
 document.getElementById("storeSummary").innerHTML=list.map(s=>{
  const r=s.records,t=totals(r);
  return `<div class="store-chip"><strong>${esc(s.store)}</strong><span>${r.length} accounts • Current: ${money(t.current)}<br>Last year: ${money(t.last)}</span></div>`;
 }).join("");
}
function canvasSetup(id){
 const c=document.getElementById(id), rect=c.getBoundingClientRect(), dpr=window.devicePixelRatio||1;
 c.width=Math.max(1,rect.width*dpr);c.height=Math.max(1,rect.height*dpr);
 const ctx=c.getContext("2d");ctx.scale(dpr,dpr);return {ctx,w:rect.width,h:rect.height};
}
function drawCharts(){
 const selected=document.getElementById("storeFilter").value;
 const stores=DATA.filter(s=>selected==="all"||s.store===selected);
 let {ctx,w,h}=canvasSetup("salesChart");ctx.clearRect(0,0,w,h);
 const max=Math.max(1,...stores.flatMap(s=>{let t=totals(s.records);return [t.current,t.last]}));
 const left=selected==="all"?125:12, right=12, top=12, bottom=24, usable=w-left-right, rowH=(h-top-bottom)/Math.max(1,stores.length);
 ctx.font="10px Segoe UI";ctx.textBaseline="middle";
 stores.forEach((s,i)=>{let t=totals(s.records), y=top+i*rowH+rowH/2, bw=usable*.76;
 ctx.fillStyle="#596477";ctx.textAlign="right";ctx.fillText(shortName(s.store),left-9,y);
 ctx.fillStyle="#aab3c2";ctx.fillRect(left,y-8,bw*t.last/max,7);
 ctx.fillStyle="#c8102e";ctx.fillRect(left,y+2,bw*t.current/max,7);
 });
 ctx.fillStyle="#7b8493";ctx.textAlign="left";ctx.fillText("Scale based on highest recorded store total",left,h-7);
 let v=totals(getAllRows()), pos=v.positive, neg=v.negative, miss=v.incomplete;
 let p=canvasSetup("varianceChart");ctx=p.ctx;w=p.w;h=p.h;ctx.clearRect(0,0,w,h);
 const items=[["Positive",pos,"#168653"],["Negative",neg,"#c8102e"],["Incomplete",miss,"#aab3c2"]];
 const sum=items.reduce((a,x)=>a+x[1],0)||1;let x=12, y=25, barW=w-24, barH=28;
 items.forEach(([label,val,color])=>{let seg=barW*val/sum;ctx.fillStyle=color;ctx.fillRect(x,y,seg,barH);x+=seg});
 items.forEach(([label,val,color],i)=>{let yy=83+i*42;ctx.fillStyle=color;ctx.fillRect(12,yy-6,9,9);ctx.fillStyle="#344054";ctx.font="12px Segoe UI";ctx.textAlign="left";ctx.fillText(label,29,yy);ctx.textAlign="right";ctx.fillText(val+" accounts",w-12,yy)});
 ctx.fillStyle="#7b8493";ctx.textAlign="left";ctx.font="10px Segoe UI";ctx.fillText("Variance records counted only where source data exists.",12,h-10);
}
function shortName(s){return s.replace("Jollibee ","").replace(" Drive-Thru"," DT").replace("Boundary","Bdy").replace("Town Center","TC");}
function resetFilters(){document.getElementById("storeFilter").value="all";document.getElementById("statusFilter").value="all";document.getElementById("search").value="";render();}
loadSaved();
populateStores();
["storeFilter","statusFilter","search"].forEach(id=>document.getElementById(id).addEventListener(id==="search"?"input":"change",render));
render();window.addEventListener("resize",drawCharts);
</script>
</body></html>
